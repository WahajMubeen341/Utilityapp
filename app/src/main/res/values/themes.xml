<resources>

    <!-- Your main app theme -->
    <style name="Theme.UtilityApp" parent="android:Theme.Material.Light.NoActionBar" />

    <!-- Splash theme -->
    <style name="Theme.UtilityApp.Starting" parent="Theme.SplashScreen">
        <!-- Background color -->
        <item name="windowSplashScreenBackground">@color/white</item>

        <!-- App icon or custom logo -->
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>

        <!-- Theme after splash ends -->
        <item name="postSplashScreenTheme">@style/Theme.UtilityApp</item>
    </style>

</resources>
